# .env.test — Biến môi trường dành riêng cho môi trường TEST (Jest)
# File này KHÔNG được commit lên Git nếu chứa thông tin nhạy cảm.
# Hiện tại chỉ trỏ vào DB local nên an toàn.

# Dùng DB riêng để TEST không bao giờ động vào DB thật (construction_db)
LOCAL_DATABASE_URL=postgres://postgres:postgres123@localhost:5432/construction_db_test

# Chỉ dùng DB local khi test — trỏ thẳng vào construction_db_test
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/construction_db_test


NODE_ENV=test
ALLOW_PUBLIC_REGISTER=true

# Session secret cho test (bất kỳ chuỗi nào cũng được)
SESSION_SECRET=test-secret-not-for-production

APP_BASE_URL=http://localhost:3000

# Email: mock — emailSender.js bị mock trong Jest nên không cần SMTP thật
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=test@test.com
