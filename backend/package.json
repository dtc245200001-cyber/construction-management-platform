{
  "name": "backend",
  "version": "1.0.0",
  "description": "Construction Management Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "build": "node -e \"require('./app.js'); console.log('Build check passed')\"",
