{
  "name": "backend",
  "version": "1.0.0",
  "description": "Construction Management Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:migrate": "node -r dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate up --no-check-order && node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "build": "node --check server.js app.js routes/authRoutes.js routes/categoryRoutes.js routes/projectRoutes.js middleware/auth.js middleware/projectAccess.js middleware/errorHandler.js config/db.js utils/logger.js utils/asyncHandler.js utils/validators.js routes/diaryDaysRoutes.js utils/diaryDayValidators.js utils/diaryDayGuard.js && echo 'Syntax check passed'",
    "test": "jest --runInBand --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest --selectProjects unit --runInBand --forceExit",
    "test:integration": "cross-env NODE_ENV=test jest --selectProjects integration --runInBand --forceExit",
    "migrate:up": "node -r dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate up --no-check-order",
    "migrate:down": "node -r dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate down --no-check-order"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "node-pg-migrate": "^6.2.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.4"
  },
  "type": "commonjs",
  "jest": {
    "testTimeout": 120000,
    "globalSetup": "./jest.globalSetup.js",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testEnvironment": "node",
    "testEnvironmentOptions": {
      "env": {
        "NODE_ENV": "test"
      }
    },
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "setupFiles": [
          "./jest.setup.js"
        ],
        "testMatch": [
          "<rootDir>/__tests__/*.test.js"
        ],
        "testPathIgnorePatterns": [
          "workItemTree.test.js",
          "integration"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "setupFiles": [
          "./jest.setup.js"
        ],
        "testMatch": [
          "<rootDir>/__tests__/integration/**/*.test.js",
          "<rootDir>/__tests__/workItemTree.test.js"
        ]
      }
    ]
  }
}
