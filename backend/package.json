{
  "name": "backend",
  "version": "1.0.0",
  "description": "Construction Management Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:migrate": "node -r dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate up && node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "build": "node --check server.js app.js routes/authRoutes.js routes/categoryRoutes.js routes/projectRoutes.js middleware/auth.js middleware/projectAccess.js middleware/errorHandler.js config/db.js utils/logger.js utils/asyncHandler.js utils/validators.js && echo 'Syntax check passed'",
    "test": "jest --testPathIgnorePatterns='workItemTree.test.js'",
    "test:unit": "jest --testPathIgnorePatterns='workItemTree.test.js' --runInBand",
    "test:integration": "jest __tests__/workItemTree.test.js --runInBand",
    "migrate:up": "node -r dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate up",
    "migrate:down": "node -r dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate down"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.1.3",
    "supertest": "^6.3.4"
  },
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
