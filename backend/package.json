    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^6.2.2",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.4"
  },
  "type": "commonjs"
}
