PORT=3000

# ─── Cơ sở dữ liệu ───────────────────────────────────────────────────────────
# Ưu tiên DATABASE_URL (Render, các PaaS). Nếu không có thì dùng DB_* riêng lẻ.
DATABASE_URL=postgres://postgres:your_password@postgres:5432/construction_db

DB_HOST=postgres
DB_PORT=5432
DB_NAME=construction_db
DB_USER=postgres
DB_PASSWORD=your_password

# Bật TLS khi kết nối DB (Render yêu cầu DB_SSL=true)
DB_SSL=false

# ─── PostgreSQL container (docker-compose) ───────────────────────────────────
POSTGRES_DB=construction_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# ─── Session ─────────────────────────────────────────────────────────────────
# BẮT BUỘC trên production. Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Danh sách origin được phép, phân tách bằng dấu phẩy (không có dấu cách)
CORS_ORIGINS=http://localhost:5173

# ─── Cookie ──────────────────────────────────────────────────────────────────
# lax (mặc định, cùng domain) hoặc none (khác domain — yêu cầu HTTPS + secure:true)
COOKIE_SAMESITE=lax

# ─── Rate limit (tuỳ chỉnh nếu cần) ─────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000